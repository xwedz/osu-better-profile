{
  "manifest_version": 3,
  "name": "osu! Better Profile",
  "version": "1.0.0",
  "description": "Enhance your osu! profile page with detailed statistics and advanced player data.",
  "author": "xwedz",
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },  
  "permissions": [
    "storage",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://osu.ppy.sh/users/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}